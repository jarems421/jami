{
  "name": "jami-flashcards",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && next dev --webpack",
    "build": "next build --webpack",
    "prebuild": "node scripts/check-marking-benchmark.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check:disk": "node scripts/check-disk.mjs",
    "eval:interventions": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/intervention-generation-batch.ts",
    "eval:revision-lesson": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/revision-lesson.ts",
    "eval:tutor-agent": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/tutor-agent.ts",
    "eval:research-models": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/research-model-compare.ts",
    "eval:image-models": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/image-model-compare.ts",
    "eval:tutor-diagrams": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/tutor-diagram.ts",
    "check:availability-latency": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/concept-availability-latency.ts",
    "clean:artifacts": "node scripts/check-disk.mjs --clean",
    "check:ai-release": "node --env-file-if-exists=.env.local scripts/check-ai-provider-release.mjs --live",
    "check:ai-benchmark": "node scripts/check-ai-benchmark.mjs",
    "check:paper-benchmark": "node scripts/check-paper-generation-benchmark.mjs",
    "check:marking-benchmark": "node scripts/check-marking-benchmark.mjs",
    "check:marking-release": "node scripts/check-marking-benchmark.mjs --release",
    "corpus:report": "node --no-warnings scripts/corpus-report.mjs",
    "corpus:holdout": "node --no-warnings scripts/corpus-holdout.mjs",
    "corpus:experiment": "node --no-warnings scripts/corpus-experiment.mjs",
    "eval:exemplar": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/exemplar-run.ts",
    "fit:learner-model": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/learner-model-fit.ts",
    "diff:concept-relations": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/concept-relation-diff.ts",
    "check:study-latency": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/study-asset-latency.ts",
    "check:ink-latency": "node scripts/run-ts.mjs scripts/eval/ink-latency.ts",
    "check": "npm run typecheck && npm run lint && npm run check:sizes && npm run check:paper-benchmark && npm run check:marking-benchmark && npm test",
    "verify:all": "npm run check && npm run build && npm run test:rules && npm run test:e2e",
    "emulators:free": "node scripts/free-emulator-ports.mjs",
    "test:rules": "npm run emulators:free && firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "npm run emulators:free && firebase emulators:exec --project demo-jami-browser --only auth,firestore,storage \"playwright test\"",
    "test:e2e:smoke": "npm run emulators:free && firebase emulators:exec --project demo-jami-browser --only auth,firestore,storage \"playwright test smoke.spec\"",
    "emulators:rules": "firebase emulators:start --only firestore,storage",
    "firebase:login": "firebase login",
    "firebase:projects": "firebase projects:list",
    "firebase:rules:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "report:ai-spend": "node --env-file-if-exists=.env.local scripts/ai-spend-report.mjs",
    "audit:legacy-shapes": "node --env-file-if-exists=.env.local scripts/audit-legacy-shapes.mjs",
    "report:analytics": "node --env-file-if-exists=.env.local scripts/analytics-report.mjs",
    "postinstall": "node scripts/copy-sql-wasm.mjs",
    "check:marking-live": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/eval/marking-live-signal.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@napi-rs/canvas": "^1.0.9",
    "@sentry/nextjs": "^10.73.0",
    "cheerio": "^1.1.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "fzstd": "^0.1.1",
    "js-draw": "^1.33.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.15",
    "officeparser": "^7.8.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.2",
    "svg-to-pdfkit": "^0.1.8",
    "ts-fsrs": "^5.3.2",
    "web-push": "^3.6.7",
    "workflow": "^4.8.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@js-draw/math": "^1.33.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.11",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "fast-uri": "3.1.8",
    "officeparser": {
      "pdfjs-dist": "6.3.289"
    },
    "protobufjs": "7.6.5",
    "qs": "6.16.0",
    "tar": "7.5.22",
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "undici": "7.29.1",
    "websocket-driver": "0.7.5"
  }
}
