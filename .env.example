NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-public-vapid-key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
WEB_PUSH_VAPID_PRIVATE_KEY=your-private-vapid-key
WEB_PUSH_SUBJECT=mailto:you@example.com
CRON_SECRET=your-random-cron-secret
GEMINI_API_KEY=your-gemini-api-key
# OpenRouter handles the private role-based text models. Keep this secret and
# configure the same Zero Data Retention/model allowlist in its guardrail.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_ENABLED=false
OPENROUTER_PRIVACY_APPROVED=false
OPENROUTER_QUALITY_GATE_PASSED=false
OPENROUTER_KILL_SWITCH=false
OPENROUTER_JUROR_KILL_SWITCH=false
# A role's model and its provider allowlist are one setting in two variables.
# The allowlist must name an endpoint that actually serves that model at the
# role's context floor, or every request fails closed with OpenRouter's "No
# allowed providers are available for the selected model" -- which is what took
# the Tutor down while papers and marking, on a different role, kept working.
# `npm run check:ai-release --live` validates the pairing; run it after any
# change here, and never copy one of these lines without the other.
OPENROUTER_WORKER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_WORKER_PROVIDERS=baseten,morph
OPENROUTER_WORKER_FAILOVER_PROVIDERS=near-ai,inceptron
OPENROUTER_SUPERVISOR_MODEL=qwen/qwen3.6-35b-a3b
OPENROUTER_SUPERVISOR_PROVIDERS=akashml,parasail
# At least two: a single-provider failover is dead the day that provider drifts
# out of compliance, and nobody notices until the primary blips.
OPENROUTER_SUPERVISOR_FAILOVER_PROVIDERS=coreweave,siliconflow
# Tried only after the supervisor's own endpoint has already failed twice.
OPENROUTER_SUPERVISOR_STANDBY_MODEL=moonshotai/kimi-k3
OPENROUTER_SUPERVISOR_STANDBY_PROVIDERS=deepinfra
OPENROUTER_JUROR_MODEL=moonshotai/kimi-k2.6
OPENROUTER_JUROR_PROVIDERS=moonshotai,siliconflow,parasail
# Video imports. One model, sampling the whole recording -- the frame rate is
# derived from duration so a long lecture stays inside its token budget without
# giving up on seeing what is on screen. The recheck model is pointed at a
# handful of already-identified moments, so it seeks instead of sampling.
VIDEO_GEMINI_MODEL=gemini-2.5-flash-lite
VIDEO_GEMINI_RECHECK_MODEL=gemini-3.5-flash-lite
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key

# Gemini remains a specialist for grounded research, document vision, images,
# and the existing embedding index. It is not a universal text fallback.
GEMINI_ENABLED=false
GEMINI_PRIVACY_APPROVED=false
GEMINI_QUALITY_GATE_PASSED=false
GEMINI_KILL_SWITCH=false
GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite
GEMINI_DOCUMENT_MODEL=gemini-3.5-flash-lite
GEMINI_TUTOR_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_PAPER_IMAGE_MODEL=gemini-3.1-flash-image
AI_WEB_RESEARCH_ENABLED=true
AI_TUTOR_IMAGES_ENABLED=true
AI_PAPER_IMAGES_ENABLED=true

# Durable full-paper jobs are queued by Vercel Workflow. This is a global
# service limit; each student may still queue their remaining daily allowance.
PRACTICE_PAPER_JOB_CONCURRENCY=4
# Per-provider and overall deadlines for durable full-paper generation only.
# Interactive endpoints retain their shorter in-code limits.
PRACTICE_PAPER_MODEL_TIMEOUT_MS=240000
PRACTICE_PAPER_DURABLE_DEADLINE_MS=780000
# One short paper-check pass asks whether each drawn (SVG) figure answers its
# question; a fault buys one redraw and never refuses a paper.
PRACTICE_PAPER_FIGURE_REVIEW_ENABLED=true

# Versioned UK GCSE/A-level written-paper format intelligence. Profiles are
# server-only and Gemini research must already pass its privacy/release gates.
EXAM_FORMAT_LIBRARY_ENABLED=true
PAPER_FORMAT_CONFIRMATION_ENABLED=true

# Owner-only held-out generation benchmark. Reviewer UIDs are comma-separated
# Firebase Auth UIDs. The per-case estimate must come from a measured Preview
# run; it is used only for the owner-confirmed batch projection.
PAPER_GENERATION_BENCHMARK_ENABLED=false
PAPER_QUALITY_REVIEWER_UIDS=

# Past Paper Practice. The UK boards are licensed and recorded in
# lib/practice/exam-question-rights.ts; set this to true wherever you want the
# surface visible.
NEXT_PUBLIC_ENABLE_PAST_PAPER_PRACTICE=true
# Per-board switches for a board's own material. Opt-in: omitted or false means
# that board serves nothing, so enabling a board is a deliberate act rather than
# a side effect of a corpus existing. Setting one back to false is also the
# emergency stop if a licence is withdrawn or disputed. Jami-created questions
# are unaffected -- they are not the board's material to withdraw.
EXAM_QUESTION_AQA_ENABLED=true
EXAM_QUESTION_PEARSON_EDEXCEL_ENABLED=true
EXAM_QUESTION_OCR_ENABLED=true
EXAM_QUESTION_WJEC_EDUQAS_ENABLED=true
EXAM_QUESTION_CCEA_ENABLED=true
EXAM_QUESTION_QUALIFICATIONS_SCOTLAND_ENABLED=true
EXAM_QUESTION_CAMBRIDGE_ENABLED=true
EXAM_QUESTION_PEARSON_INTERNATIONAL_ENABLED=true
EXAM_QUESTION_OXFORD_AQA_ENABLED=true
EXAM_QUESTION_IB_ENABLED=true
EXAM_QUESTION_DISABLED_SPECIFICATIONS=
PAPER_BENCHMARK_CASE_COST_ESTIMATE_USD=
# Review-only pilot projection. Keep this separate from the measured baseline estimate.
PAPER_BENCHMARK_PILOT_CASE_COST_ESTIMATE_USD=

# Durable evidence-aware marking. Enable only after Preview workflow, provider,
# privacy, and benchmark checks have passed.
PRACTICE_PAPER_MARKING_WORKFLOW_ENABLED=true
PRACTICE_PAPER_MARKING_JOB_CONCURRENCY=4
PRACTICE_PAPER_MARKING_MAX_COST_USD=0.50

# Server-side error reporting. Leave empty and nothing is initialised, sent or
# billed; paste a DSN in and errors start arriving with no code change.
SENTRY_DSN=

# What a model costs, in US dollars per million tokens, for providers that bill
# without reporting a cost back. OpenRouter reports its own and ignores this.
# The longest matching model-name prefix wins; anything absent is reported as
# unpriced rather than counted as free.
# Optional extras: "audioIn" and "imageOut" (per million tokens; a 1K image is
# 1,120 tokens) and "search" (per billed web search: Gemini 3 bills each query,
# 2.5 each grounded prompt). Free search allowances (5,000 a month on Gemini 3,
# 1,500 a day on 2.5) are not modelled, so the meter reads high, never low.
# Standard-tier prices read 28 Sep 2026 from ai.google.dev/gemini-api/docs/pricing:
AI_MODEL_PRICES_JSON={"gemini-2.5-flash-lite":{"in":0.10,"audioIn":0.30,"out":0.40,"search":0.035},"gemini-3.5-flash-lite":{"in":0.30,"out":2.50,"search":0.014},"gemini-3.1-flash-image":{"in":0.50,"out":3.00,"imageOut":60},"gemini-3.1-flash-lite-image":{"in":0.25,"out":1.50,"imageOut":30},"gemini-embedding-2":{"in":0.20,"out":0}}

# Sign-up and email-confirmation codes are sent through Resend's SMTP relay.
# RESEND_API_KEY is a "Sending access" key (Resend > API keys); EMAIL_FROM is
# an address on a domain Resend has verified (Resend > Domains). Without both,
# production refuses email sign-up; development prints the code to the server log.
RESEND_API_KEY=re_your-resend-sending-key
EMAIL_FROM=noreply@jami.study
# Optional: the name mail appears to come from. Defaults to "Jami".
EMAIL_FROM_NAME=Jami

# Background photos that would be stretched to fill the screen are restored by
# Real-ESRGAN on Replicate. Off unless all three are set; the page falls back
# to enlarging the photo itself. REPLICATE_UPSCALE_VERSION pins a model version
# instead of using the latest.
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_ENABLED=false
REPLICATE_PRIVACY_APPROVED=false
REPLICATE_UPSCALE_VERSION=

# Jami Ink, the notebook's own ink engine (docs/notebook-ink.md). On by default.
# Set to false and notebooks and the exam working sheet draw with js-draw, as
# before: the emergency fallback.
NEXT_PUBLIC_ENABLE_JAMI_INK=true

# A zoomed notebook page pans with the iPad's own scrolling (smooth even in
# Low Power Mode). Set to false to go back to the notebook's own panning.
NEXT_PUBLIC_ENABLE_NOTEBOOK_NATIVE_SCROLL=true

# Plans and payments (docs/plans-and-stardust.md §5). Billing stays off, and
# checkout refuses, until the flag and every Stripe value below are set.
NEXT_PUBLIC_ENABLE_BILLING=false
# Accounts created before this moment keep Lifetime access (ISO date).
BILLING_LAUNCH_AT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids of the Nova (plus) and Celestial (pro) monthly prices.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
